{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cofibuy",
  "main": "worker/worker.ts",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
