# Copy to .env.local and fill in. Never commit real values.
#
# Both values are safe to expose to the browser: the anon key is restricted by
# row level security. They are held in the host's environment so the repository
# stays credential-free.

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# "anon" / "publishable" API key from Project Settings -> API
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side only. NEVER prefix these with VITE_ and never commit them.
# They are read by the OTP worker and by database tooling, not by the app.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=  # full database bypass, worker only
# SUPABASE_DB_URL=           # postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
