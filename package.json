{
  "name": "cofibuy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler dev",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "db:push": "supabase db push",
    "db:link": "supabase link --project-ref",
    "db:reset": "supabase db reset",
    "db:studio": "supabase studio",
    "db:types": "node scripts/generate-types.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run functions:check && npm run functions:test && npm run test",
    "check:all": "npm run check && npm run test:db && npm run db:types:check",
    "functions:check": "deno check --config supabase/functions/deno.json supabase/functions/bkash-create-payment/index.ts supabase/functions/bkash-execute/index.ts supabase/functions/ai-fill-form/index.ts",
    "functions:test": "deno test --allow-env --config supabase/functions/deno.json supabase/functions",
    "functions:deploy": "supabase functions deploy --import-map supabase/functions/deno.json",
    "bootstrap": "node scripts/bootstrap.mjs",
    "db:types:check": "node scripts/generate-types.mjs --check",
    "deploy": "npm run build && wrangler deploy",
    "deploy:bot": "wrangler deploy --config bot/wrangler.toml"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "@vueuse/core": "15.0.0",
    "chart.js": "^4.5.1",
    "dompurify": "3.4.16",
    "lucide-vue-next": "^1.0.0",
    "marked": "18.0.14",
    "vue": "3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "11.4.12",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/test-utils": "2.5.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "supabase": "2.118.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "embedded-postgres@18.4.0-beta.17": true
  }
}
